[Desktop Entry]
Type=Application
Name=MyConnect
GenericName=Device Connection
Comment=Pair with your devices and share files and the clipboard over the local network
# install.sh replaces this with the bundle's absolute path.
Exec=myconnect_ui
Icon=org.myconnect.myconnect_ui
Terminal=false
Categories=Network;FileTransfer;
Keywords=KDE Connect;phone;pair;clipboard;file transfer;
StartupNotify=true
StartupWMClass=org.myconnect.myconnect_ui
SingleMainWindow=true
