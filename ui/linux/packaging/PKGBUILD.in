# Repackages the release's .deb for Arch Linux. The release workflow fills in
# the @...@ fields (see pkgbuild.sh) and attaches the result to the release:
# download it into an empty directory and run `makepkg -si`.

pkgname=myconnect-bin
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Pair with your devices and share files and the clipboard over the local network'
arch=(x86_64 aarch64)
url='https://github.com/simophin/myconnect'
# No license chosen yet.
license=(LicenseRef-unknown)
# The .deb's Depends (from dpkg-shlibdeps) under Arch's names; libglvnd
# provides the libEGL the Flutter engine loads at runtime.
depends=(
  at-spi2-core cairo fontconfig gdk-pixbuf2 glib2 glibc gtk3 harfbuzz
  hicolor-icon-theme libepoxy libgcc libglvnd libstdc++ libx11 libxi pango zlib
)
provides=(myconnect)
conflicts=(myconnect)
# Ship the binaries exactly as they are in the .deb.
options=(!strip !debug)
_tag=@TAG@
_release=$url/releases/download/$_tag
source_x86_64=("$_release/myconnect_@DEBVER@_amd64.deb")
source_aarch64=("$_release/myconnect_@DEBVER@_arm64.deb")
sha256sums_x86_64=('@SHA256_AMD64@')
sha256sums_aarch64=('@SHA256_ARM64@')

package() {
  bsdtar -xf data.tar.* -C "$pkgdir"
}
