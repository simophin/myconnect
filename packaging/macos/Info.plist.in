<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!-- The app's languages (packaging/i18n.sh), so that the system's own
	     dialogs and texts in it (file pickers, notifications' buttons,
	     prompts) follow the app's language rather than staying English. -->
	<key>CFBundleLocalizations</key>
	<array>@LOCALIZATIONS@</array>
	<key>CFBundleExecutable</key>
	<string>Ferry</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>dev.fanchao.Ferry</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Ferry</string>
	<key>CFBundleDisplayName</key>
	<string>Ferry</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@BUILD@</string>
	<key>LSMinimumSystemVersion</key>
	<string>@MINIMUM_SYSTEM_VERSION@</string>
	<!-- In the menu bar, with no Dock icon until the window opens. -->
	<key>LSUIElement</key>
	<true/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Each <lang>.lproj/InfoPlist.strings has it in its language. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Ferry finds and connects to your devices on the local network.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Fanchao</string>
</dict>
</plist>
